{
  "sentences": [
    {
      "start_ms": 0,
      "end_ms": 5267,
      "text": "పార్వతీదేవి పసుపు పిండితో ఒక చిన్న బాలుణ్ణి చేసింది."
    },
    {
      "start_ms": 5267,
      "end_ms": 7842,
      "text": "అతను కళ్ళు తెరిచి నవ్వాడు!"
    },
    {
      "start_ms": 7842,
      "end_ms": 14396,
      "text": "ఆమె అతనికి ప్రాణం పోసి, \"నువ్వు నా కొడుకువి\" అని ప్రేమగా ముద్దాడింది."
    },
    {
      "start_ms": 14396,
      "end_ms": 18143,
      "text": "ఆ బాలుడు ఆమెను గట్టిగా హత్తుకున్నాడు."
    }
  ]
}
