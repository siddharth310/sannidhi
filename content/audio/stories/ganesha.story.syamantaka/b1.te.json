{
  "sentences": [
    {
      "start_ms": 0,
      "end_ms": 5263,
      "text": "సత్రాజిత్తు సూర్యుణ్ణి భక్తితో పూజించాడు."
    },
    {
      "start_ms": 5263,
      "end_ms": 11380,
      "text": "సూర్యుడు సంతోషించి, తనలాగే వెలిగే ఒక మణిని ఇచ్చాడు."
    },
    {
      "start_ms": 11380,
      "end_ms": 12944,
      "text": "అదే శమంతకమణి."
    },
    {
      "start_ms": 12944,
      "end_ms": 15933,
      "text": "అది ఉన్నచోట అంతా సమృద్ధే."
    }
  ]
}
