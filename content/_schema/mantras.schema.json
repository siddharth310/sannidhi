{
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "id",
   "deity",
   "status",
   "kind",
   "text",
   "lines",
   "use",
   "meaning",
   "needs_review"
  ],
  "properties": {
   "id": {
    "type": "string"
   },
   "deity": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "reviewed",
     "published",
     "retired"
    ]
   },
   "kind": {
    "enum": [
     "mantra",
     "upachara"
    ]
   },
   "text": {
    "anyOf": [
     {
      "$ref": "#/$defs/S"
     },
     {
      "type": "null"
     }
    ]
   },
   "lines": {
    "type": "array",
    "items": {
     "$ref": "#/$defs/S"
    }
   },
   "use": {
    "type": "array",
    "items": {
     "enum": [
      "japa",
      "puja"
     ]
    }
   },
   "count_default": {
    "type": [
     "integer",
     "null"
    ]
   },
   "audio": {
    "anyOf": [
     { "type": "null" },
     {
      "type": "object",
      "required": ["file", "length_ms"],
      "additionalProperties": false,
      "properties": {
       "file": { "type": "string" },
       "length_ms": { "type": "integer", "minimum": 1 },
       "words_ms": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
       "draft": { "type": "boolean" }
      }
     }
    ]
   },
   "meaning": {
    "anyOf": [
     {
      "$ref": "#/$defs/L"
     },
     {
      "type": "null"
     }
    ]
   },
   "fills": {
    "type": [
     "object",
     "null"
    ]
   },
   "needs_review": {
    "type": "boolean"
   }
  },
  "additionalProperties": false
 },
