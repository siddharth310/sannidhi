{
  "sentences": [
    {
      "start_ms": 0,
      "end_ms": 6448,
      "text": "గణపతి అమ్మానాన్నల చుట్టూ మూడుసార్లు తిరిగి నమస్కరించాడు."
    },
    {
      "start_ms": 6448,
      "end_ms": 8640,
      "text": "\"మీరే నా లోకం\" అన్నాడు."
    },
    {
      "start_ms": 8640,
      "end_ms": 11090,
      "text": "శివపార్వతులు నవ్వారు."
    },
    {
      "start_ms": 11090,
      "end_ms": 16120,
      "text": "జ్ఞానం అంటే వేగం కాదు, అసలైనది ఏదో తెలుసుకోవడం."
    },
    {
      "start_ms": 16120,
      "end_ms": 18444,
      "text": "పండు గణపతికే ఇచ్చారు."
    }
  ]
}
