{
  "sentences": [
    {
      "start_ms": 0,
      "end_ms": 3979,
      "text": "కుమారస్వామి వచ్చి కొంచెం బాధపడ్డాడు."
    },
    {
      "start_ms": 3979,
      "end_ms": 9451,
      "text": "అమ్మ దగ్గరకు తీసుకుని, \"నువ్వే మాకు తీయని పండువి\" అంది."
    },
    {
      "start_ms": 9451,
      "end_ms": 12435,
      "text": "తమిళంలో \"పళం నీ\" — \"నువ్వే పండువి\"."
    },
    {
      "start_ms": 12435,
      "end_ms": 17038,
      "text": "ఆ మాటే పళని కొండ పేరుగా నిలిచిందని చెబుతారు."
    }
  ]
}
