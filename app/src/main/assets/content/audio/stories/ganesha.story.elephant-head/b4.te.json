    {
      "start_ms": 0,
      "end_ms": 1894,
      "text": "పార్వతి ఏడ్చింది."
    },
    {
      "start_ms": 1894,
      "end_ms": 7955,
      "text": "శివుడు బాధపడి, \"మొదట కనిపించిన జీవి తల తీసుకురండి\" అన్నాడు."
    },
    {
      "start_ms": 7955,
      "end_ms": 11618,
      "text": "వాళ్ళకు ఒక దయగల ఏనుగు కనిపించింది."
    }
  ]
