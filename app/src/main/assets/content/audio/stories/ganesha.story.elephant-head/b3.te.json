{
  "sentences": [
    {
      "start_ms": 0,
      "end_ms": 2420,
      "text": "అప్పుడు శివుడు వచ్చాడు."
    },
    {
      "start_ms": 2420,
      "end_ms": 7382,
      "text": "\"అమ్మ మాట ఇచ్చాను — లోపలికి రావద్దు\" అన్నాడు బాలుడు."
    },
    {
      "start_ms": 7382,
      "end_ms": 10528,
      "text": "శివుడికి ఆ బాలుడు ఎవరో తెలియదు."
    },
    {
      "start_ms": 10528,
      "end_ms": 13553,
      "text": "బాలుడికీ శివుడు ఎవరో తెలియదు."
    },
    {
      "start_ms": 13553,
      "end_ms": 15852,
      "text": "ఇద్దరూ పట్టు వదల్లేదు."
    },
    {
      "start_ms": 15852,
      "end_ms": 19850,
      "text": "ఆ గొడవలో, ఒక్క క్షణంలో, బాలుడి తల పోయింది."
    }
  ]
}
